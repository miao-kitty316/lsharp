-- recursion.lsh：没有循环，只有递归

let factorial n =
  if n == 0 then 1 else n * factorial (n - 1)

let fib n =
  if n < 2 then n else fib (n - 1) + fib (n - 2)

print (factorial 10)                        -- 3628800
print (fib 20)                              -- 6765
print (sum (map factorial (range 1 6)))     -- 1!+2!+3!+4!+5! = 153
